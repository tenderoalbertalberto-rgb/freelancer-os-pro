# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/freelancer_os"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Stripe (para cobros)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App config
APP_NAME="Freelancer OS Pro"
DEFAULT_CURRENCY="USD"
DEFAULT_LANGUAGE="es"